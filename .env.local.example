# Local development overrides (copy to .env.local on your machine)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cholbe?schema=public"

JWT_SECRET="change-me-in-development"
JWT_EXPIRES_IN="7d"

PORT=3000
NODE_ENV=development

UPLOAD_DIR="./uploads"
MAX_FILE_SIZE_MB=10

APP_NAME="Cholbe Pharmacy API"
APP_URL="http://localhost:3000"

AGORA_APP_ID=""
AGORA_APP_CERTIFICATE=""
