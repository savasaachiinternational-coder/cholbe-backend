# Local development overrides (copy to .env.local on your machine)
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/cholbe?schema=public"

JWT_SECRET="change-me-in-development"
JWT_EXPIRES_IN="7d"

PORT=3000
NODE_ENV=development

UPLOAD_DIR="./uploads"
MAX_FILE_SIZE_MB=10

APP_NAME="Cholbe Pharmacy API"
APP_URL="http://localhost:3000"

AGORA_APP_ID=""
AGORA_APP_CERTIFICATE=""

# Firebase service account (Project settings → Service accounts → Generate new private key)
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""
